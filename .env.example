PORT=5000
NODE_ENV=development

# Database Configuration
# Option 1 (Recommended for Railway / Cloud):
# DATABASE_URL=postgresql://postgres:PASSWORD@junction.proxy.rlwy.net:12345/railway

# Option 2: Individual parameters
# For Railway, use the values from Railway Dashboard -> Variables (PGHOST, PGPORT, etc.)
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=billpro_db
DB_USER=postgres
DB_PASSWORD=postgres
# Set DB_SSL=true when connecting remotely to Railway from your local machine
# (Auto-enabled if DB_HOST is remote or DATABASE_URL is used)
DB_SSL=false
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=billpro_super_secret_jwt_key_2026_dev_environment
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=billpro_super_secret_refresh_key_2026_dev_environment
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
