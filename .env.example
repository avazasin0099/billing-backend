PORT=5000
NODE_ENV=development

# Database Configuration
# Set DB_DIALECT=postgres for PostgreSQL, or sqlite for zero-config local/test
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=billpro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=billpro_super_secret_jwt_key_2026_dev_environment
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=billpro_super_secret_refresh_key_2026_dev_environment
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
